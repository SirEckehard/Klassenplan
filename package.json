{
  "name": "klassenplan",
  "version": "1.5.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=10.9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.13.12",
    "@xstate/react": "^6.0.0",
    "fast-deep-equal": "^3.1.3",
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.1",
    "react-router-dom": "^7.8.0",
    "web-vitals": "^5.1.0",
    "xstate": "^5.24.0",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:sitemap": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/generate-sitemap.mjs",
    "indexnow:ping": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/indexnow-ping.mjs",
    "prebuild": "npm run generate:sitemap",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md,json}\""
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/vite": "^4.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/ui": "^4.0.15",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15",
    "workbox-build": "^7.3.0"
  }
}
