# Klassenplan environment variables — ALL OPTIONAL.
# The app runs 100% in the browser and needs none of these to build or run.
# They only affect the SEO build scripts (sitemap / IndexNow) and a dev flag.
# Copy this file to ".env" and fill in what you need. ".env" is gitignored.

# Canonical site origin used when generating the sitemap and pinging IndexNow.
# Defaults to https://klassenplan.de when unset.
SITE_URL=https://klassenplan.de

# IndexNow API key (32+ hex chars) for `npm run indexnow:ping`.
# When unset, the IndexNow ping is simply skipped.
# The script hosts the key at <SITE_URL>/<key>.txt — do not commit that generated file.
INDEXNOW_KEY=

# Optional override for where the IndexNow key file is hosted.
# Defaults to <SITE_URL>/<INDEXNOW_KEY>.txt.
INDEXNOW_KEY_LOCATION=

# Enable the in-app performance dashboard during development.
# Defaults to false in production builds.
VITE_FLAG_PERFORMANCE_DASHBOARD=false
