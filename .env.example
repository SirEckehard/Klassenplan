# Klassenplan environment variables — ALL OPTIONAL.
# The app runs 100% in the browser and needs none of these to build or run.
# They affect what the build bakes in (canonical URLs, legal pages), the SEO
# scripts (sitemap / IndexNow) and Docker Compose.
# Copy this file to ".env" and fill in what you need. ".env" is gitignored.

# Canonical site origin. Drives the sitemap and IndexNow scripts, and is baked
# into the bundle at build time (canonical, hreflang, og:url). A build for a
# staging host must set this, otherwise those tags point at production.
# Defaults to https://klassenplan.de when unset.
SITE_URL=https://klassenplan.de

# Your own Impressum and Datenschutzerklärung. Set both when you publish your own
# instance — otherwise the build ships the legal pages of klassenplan.de. When
# set, the footer links to these pages, /impressum and /datenschutz only point
# there, and klassenplan.de's texts are left out of the bundle. Absolute http(s)
# URLs; the build fails on anything else. Baked in at build time, so they take
# effect with `docker compose up -d --build`.
IMPRINT_URL=
PRIVACY_URL=

# IndexNow API key (32+ hex chars) for `npm run indexnow:ping`.
# When unset, the IndexNow ping is simply skipped.
# The script hosts the key at <SITE_URL>/<key>.txt — do not commit that generated file.
INDEXNOW_KEY=

# Optional override for where the IndexNow key file is hosted.
# Defaults to <SITE_URL>/<INDEXNOW_KEY>.txt.
INDEXNOW_KEY_LOCATION=

# --- Docker Compose only (see docker-compose.yml) ---

# Which published image docker-compose runs. Defaults to "latest"; pin a
# release (e.g. 2.0.0 or 2.0) to stay on a known version across pulls.
KLASSENPLAN_VERSION=latest

# Host port the container is published on. Defaults to 8080.
KLASSENPLAN_PORT=8080
