# TypeScript is installed side-by-side: "typescript" is aliased to
# @typescript/typescript6 (TS 6 API, consumed by @typescript-eslint and
# eslint-import-resolver-typescript), while TS 7 lives under @typescript/native
# and is invoked by explicit path in the typecheck scripts. Do not "fix" the
# typescript alias back to a plain version range -- TS 7 ships no compiler API
# until 7.1, which would break typed linting.
#
# legacy-peer-deps is required because eslint-plugin-react 7 declares the peer
# dependency eslint up to ^9.7, while the project runs ESLint 10. Remove once a
# release of eslint-plugin-react accepts ESLint 10.
legacy-peer-deps=true
